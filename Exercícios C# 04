// Programa que pergunta se o usuário não deseja cancelar uma operação
class Program
{
    static void Main(string[] args)
    {
        string resposta;
        bool naoQuerCancelar;
 
        Console.Write("Você não deseja cancelar a operação? (sim/nao): ");
        resposta = Console.ReadLine();
 
        // Guardamos true se o usuário respondeu "sim" (ou seja, confirma que NÃO quer cancelar)
        naoQuerCancelar = (resposta.ToLower() == "sim");
 
        // Se a resposta for negativa ("nao"), significa que ele QUER cancelar
        if (!naoQuerCancelar)
        {
            Console.WriteLine("Por favor, confirme o cancelamento da operação");
        }
        else
        {
            Console.WriteLine("A operação continuará normalmente.");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}
