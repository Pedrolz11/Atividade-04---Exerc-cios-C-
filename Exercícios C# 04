1- a) using System;
 
// Programa que verifica se a pessoa pode dirigir:
// precisa ter mais de 18 anos E ter carteira de motorista
class Program
{
    static void Main(string[] args)
    {
        int idade;
        string temCarteira;
 
        Console.Write("Digite sua idade: ");
        idade = Convert.ToInt32(Console.ReadLine());
 
        Console.Write("Você possui carteira de motorista? (sim/nao): ");
        temCarteira = Console.ReadLine();
 
        // O operador && (E lógico) só é verdadeiro se as DUAS condições forem verdadeiras
        // Usamos .ToLower() para não ter problema se o usuário digitar "Sim", "SIM", etc.
        if (idade > 18 && temCarteira.ToLower() == "sim")
        {
            Console.WriteLine("Você pode dirigir");
        }
        else
        {
            Console.WriteLine("Você não pode dirigir");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

