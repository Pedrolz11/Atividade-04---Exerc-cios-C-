// Programa que verifica se um número NÃO é igual a zero
class Program
{
    static void Main(string[] args)
    {
        int numero;
 
        Console.Write("Digite um número: ");
        numero = Convert.ToInt32(Console.ReadLine());
 
        // != já significa "diferente de", mas aqui usamos ! junto com == para
        // reforçar o uso do operador de negação, como pede o exercício
        if (!(numero == 0))
        {
            Console.WriteLine("O número é diferente de zero");
        }
        else
        {
            Console.WriteLine("O número é igual a zero");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

