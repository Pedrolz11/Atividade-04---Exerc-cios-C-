// Programa que pergunta se o usuário é um membro inativo do clube
// e usa o operador de negação (!) para verificar o caso contrário
class Program
{
    static void Main(string[] args)
    {
        string resposta;
        bool naoEhInativo;
 
        // A pergunta já vem com a negação, como pede o exercício
        Console.Write("Você não é um membro inativo do clube? (sim/nao): ");
        resposta = Console.ReadLine();
 
        // Guardamos true se o usuário respondeu "sim" (ou seja, confirma que NÃO é inativo)
        naoEhInativo = (resposta.ToLower() == "sim");
 
        // Usamos ! para tratar o caso da resposta ser negativa ("nao"),
        // que significa que a pessoa É um membro inativo
        if (!naoEhInativo)
        {
            Console.WriteLine("Por favor, atualize sua inscrição para continuar usufruindo dos benefícios do clube");
        }
        else
        {
            Console.WriteLine("Sua inscrição está em dia.");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

n) using System;
 
// Programa que verifica se a palavra digitada NÃO é vazia
class Program
{
    static void Main(string[] args)
    {
        string palavra;
 
        Console.Write("Digite uma palavra: ");
        palavra = Console.ReadLine();
 
        // string.IsNullOrEmpty() retorna true se a palavra estiver vazia (ou nula)
        // O ! na frente inverte o resultado: "se NÃO estiver vazia"
        if (!string.IsNullOrEmpty(palavra))
        {
            Console.WriteLine("A palavra não é vazia");
        }
        else
        {
            Console.WriteLine("Você não digitou nenhuma palavra");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

