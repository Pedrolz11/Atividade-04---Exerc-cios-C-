k) using System;
 
// Programa que pergunta se o usuário é um robô e usa o operador de negação (!)
class Program
{
    static void Main(string[] args)
    {
        string resposta;
        bool ehRobo;
 
        Console.Write("Você é um robô? (sim/nao): ");
        resposta = Console.ReadLine();
 
        // Guardamos a resposta como um valor booleano (true ou false)
        ehRobo = (resposta.ToLower() == "sim");
 
        // O operador ! (negação) inverte o valor: se ehRobo for false, !ehRobo vira true
        // Ou seja: "se a pessoa NÃO é um robô"
        if (!ehRobo)
        {
            Console.WriteLine("Por favor, prove que você não é um robô");
        }
        else
        {
            Console.WriteLine("Acesso negado para robôs.");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

