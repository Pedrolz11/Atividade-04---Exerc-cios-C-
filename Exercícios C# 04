g) using System;
 
// Programa que verifica se um número é divisível por 3 OU por 5
class Program
{
    static void Main(string[] args)
    {
        int numero;
 
        Console.Write("Digite um número inteiro: ");
        numero = Convert.ToInt32(Console.ReadLine());
 
        // % é o operador de módulo (resto da divisão)
        // Se o resto da divisão por 3 for 0, o número é divisível por 3
        // Se o resto da divisão por 5 for 0, o número é divisível por 5
        if (numero % 3 == 0 || numero % 5 == 0)
        {
            Console.WriteLine("O número é divisível por 3 ou por 5!");
        }
        else
        {
            Console.WriteLine("O número não é divisível por 3 nem por 5.");
        }
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

