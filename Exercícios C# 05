1- a) using System;
 
// Programa que verifica se um número é par ou ímpar usando o operador ternário
class Program
{
    static void Main(string[] args)
    {
        int numero;
 
        Console.Write("Digite um número inteiro: ");
        numero = Convert.ToInt32(Console.ReadLine());
 
        // Operador ternário: condição ? valorSeVerdadeiro : valorSeFalso
        // Se o resto da divisão por 2 for 0, o texto "Par" é escolhido, senão "Ímpar"
        string resultado = (numero % 2 == 0) ? "Par" : "Ímpar";
 
        Console.WriteLine("O número " + numero + " é " + resultado);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

b) using System;
 
// Programa que encontra o maior entre dois números usando o operador ternário
class Program
{
    static void Main(string[] args)
    {
        int numero1, numero2;
 
        Console.Write("Digite o primeiro número: ");
        numero1 = Convert.ToInt32(Console.ReadLine());
 
        Console.Write("Digite o segundo número: ");
        numero2 = Convert.ToInt32(Console.ReadLine());
 
        // Se numero1 for maior que numero2, guardamos numero1, senão guardamos numero2
        int maior = (numero1 > numero2) ? numero1 : numero2;
 
        Console.WriteLine("O maior número é: " + maior);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

c) using System;
using System.Collections.Generic;
 
// Programa que verifica se uma lista está vazia usando o operador ternário
class Program
{
    static void Main(string[] args)
    {
        // Criamos uma lista de strings para simular os itens digitados pelo usuário
        List<string> lista = new List<string>();
 
        Console.Write("Quantos itens você quer adicionar na lista? ");
        int quantidade = Convert.ToInt32(Console.ReadLine());
 
        // Adicionando os itens digitados pelo usuário na lista
        for (int i = 0; i < quantidade; i++)
        {
            Console.Write("Digite o item " + (i + 1) + ": ");
            lista.Add(Console.ReadLine());
        }
 
        // lista.Count retorna a quantidade de elementos dentro da lista
        // Se for igual a 0, a lista está vazia
        string resultado = (lista.Count == 0) ? "A lista está vazia" : "A lista não está vazia";
 
        Console.WriteLine(resultado);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

