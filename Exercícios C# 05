f) using System;
 
// Programa que calcula o valor absoluto de um número usando o operador ternário
// (o valor absoluto é o número sempre positivo, sem o sinal negativo)
class Program
{
    static void Main(string[] args)
    {
        int numero;
 
        Console.Write("Digite um número inteiro: ");
        numero = Convert.ToInt32(Console.ReadLine());
 
        // Se o número for menor que 0, invertemos o sinal (multiplicando por -1)
        // Se já for maior ou igual a 0, mantemos ele como está
        int valorAbsoluto = (numero < 0) ? -numero : numero;
 
        Console.WriteLine("O valor absoluto de " + numero + " é " + valorAbsoluto);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

g) using System;
 
// Programa que verifica se um número é positivo, negativo ou zero
// usando o operador ternário ANINHADO (um ternário dentro do outro)
class Program
{
    static void Main(string[] args)
    {
        int numero;
 
        Console.Write("Digite um número inteiro: ");
        numero = Convert.ToInt32(Console.ReadLine());
 
        // Primeiro verificamos se é igual a 0
        // Se não for, aí sim verificamos se é maior que 0 (positivo) ou não (negativo)
        // Repare que o segundo ternário fica no lugar do "resultadoSeFalso" do primeiro
        string resultado = (numero == 0) ? "Zero" : (numero > 0) ? "Positivo" : "Negativo";
 
        Console.WriteLine("O número " + numero + " é: " + resultado);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

h) using System;
 
// Programa que converte uma string em número, usando o operador ternário
// para tratar o caso da conversão dar certo ou dar errado
class Program
{
    static void Main(string[] args)
    {
        Console.Write("Digite um número: ");
        string texto = Console.ReadLine();
 
        int numero;
 
        // int.TryParse tenta converter o texto para número e retorna true ou false,
        // dependendo se a conversão deu certo. O valor convertido é guardado em "numero"
        bool conseguiuConverter = int.TryParse(texto, out numero);
 
        // Usamos o ternário para escolher a mensagem de acordo com o resultado da conversão
        string resultado = conseguiuConverter ? "A conversão deu certo! O número é " + numero : "Não foi possível converter o texto em número";
 
        Console.WriteLine(resultado);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

