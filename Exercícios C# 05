// Programa que verifica se um número é divisível por outro usando o operador ternário
class Program
{
    static void Main(string[] args)
    {
        int numero1, numero2;
 
        Console.Write("Digite o número que será dividido: ");
        numero1 = Convert.ToInt32(Console.ReadLine());
 
        Console.Write("Digite o número pelo qual será dividido: ");
        numero2 = Convert.ToInt32(Console.ReadLine());
 
        // Se o resto da divisão (numero1 % numero2) for 0, então numero1 é divisível por numero2
        string resultado = (numero1 % numero2 == 0) ? numero1 + " é divisível por " + numero2 : numero1 + " NÃO é divisível por " + numero2;
 
        Console.WriteLine(resultado);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}

j) using System;
 
// Programa que verifica se uma variável é nula ou não, usando o operador ternário
class Program
{
    static void Main(string[] args)
    {
        Console.Write("Digite um texto (ou pressione Enter para deixar vazio): ");
        string texto = Console.ReadLine();
 
        // Quando o usuário só pressiona Enter, o ReadLine retorna uma string vazia (""),
        // então forçamos a variável para null se ela vier vazia, só para simular o exemplo
        string variavel = (texto == "") ? null : texto;
 
        // O operador ternário verifica se "variavel" é diferente de null
        string resultado = (variavel != null) ? "A variável NÃO é nula. Valor: " + variavel : "A variável é nula";
 
        Console.WriteLine(resultado);
 
        Console.WriteLine("Pressione qualquer tecla para sair...");
        Console.ReadKey();
    }
}
